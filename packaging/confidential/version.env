# Pinned upstream mpt-crypto release that this add-on builds/bundles against.
# Bump procedure: see packaging/confidential/README.md.
#
# MPT_CRYPTO_VERSION  : upstream git tag (also the release-asset version)
# MPT_CRYPTO_REPO     : source repo
# BUNDLE_SHA256       : sha256 of mpt-crypto-natives-<VERSION>.tar.gz
#                       (only consumed on the prebuilt path — Windows)
# MPT_CRYPTO_COMMIT   : immutable commit the tag must resolve to (source build
#                       verifies this before running upstream's build script,
#                       so a force-pushed/tampered tag is rejected). NOTE: this
#                       is the COMMIT sha (what `git rev-parse HEAD` yields after
#                       checkout), NOT the annotated-tag object sha. Get it with
#                       `git rev-list -n 1 <TAG>`.
MPT_CRYPTO_VERSION=1.0.2
MPT_CRYPTO_COMMIT=376691c5fca7898bd1161b0ac6646109d069ceb9
MPT_CRYPTO_REPO=XRPLF/mpt-crypto
BUNDLE_SHA256=8a765db71473ca4b1034f1f3140743b36ff80b66f3a1ab71769489e8f03231e9
